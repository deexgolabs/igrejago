SECRET_KEY=troque-esta-chave-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Domínios "espelho" das páginas públicas (ex.: um domínio curto na frente
# via Cloudflare Worker, repassando pro domínio principal) — sem isso,
# formulário público submetido a partir de um domínio espelho é barrado
# como CSRF inválido. URLs completas com esquema, separadas por vírgula.
# Deixe em branco se não usa domínio espelho nenhum.
CSRF_TRUSTED_ORIGINS=

# Base do site (com esquema, sem barra no final) — usada só por comandos de
# cron que precisam montar um link absoluto sem ter um `request` disponível
# (ex.: `gerar_escalas_mensais`, no link de confirmação enviado por
# WhatsApp). Views normais continuam usando `request.build_absolute_uri`.
SITE_URL=http://localhost:8000

# Domínio curto/espelho (ex.: https://igrejago.link) só pra montar a "URL
# pública" exibida em Link na Bio e Formulários — deixe em branco se não
# usa domínio espelho nenhum (os links ficam relativos, como sempre foram).
PUBLIC_LINK_DOMAIN=

# PIX e Mercado Pago não vão aqui — são configurados por igreja em
# Configurações (in-app) ou pelo admin em Church (/admin/core/church/),
# já que cada igreja tem sua própria chave/conta.

# Evolution API (WhatsApp) — infraestrutura de PLATAFORMA, um servidor só
# compartilhado por todas as igrejas (multi-tenência). Cada igreja ganha
# sua própria instância nele; a igreja nunca vê estes valores.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Webhook oficial da Meta (WhatsApp Cloud API) — um app Meta só, compartilhado
# por todas as igrejas (diferente das credenciais da Meta em Church, que são
# por igreja e só servem pra ENVIAR). Gerado no painel de desenvolvedor da
# Meta ao configurar o webhook. Ver DEPLOY.md, seção 5.4.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Mercado Pago da PLATAFORMA (Fase 4 — assinatura recorrente das igrejas,
# não confundir com o Mercado Pago DE CADA IGREJA acima). Sem isso, a
# tela de assinatura mostra erro ao tentar assinar; cobrança manual
# (Django admin) continua funcionando normal.
PLATFORM_MERCADOPAGO_ACCESS_TOKEN=

# E-mail (recuperação de senha). Sem preencher, e-mails só aparecem no
# console do servidor em dev — nada é enviado de verdade.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=naoresponda@igreja.local

# Banco de dados — deixe DB_ENGINE em branco pra usar SQLite (dev).
# Preencha com "postgresql" em produção (exige psycopg2-binary instalado).
DB_ENGINE=
DB_NAME=church_crm
DB_USER=church_crm
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Só use em produção, atrás de um proxy que já force HTTPS (ver DEPLOY.md).
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Rastreamento de erros (opcional) — sem isso, nada é inicializado.
SENTRY_DSN=

# Notificações push do navegador (opcional) — gere um par de chaves VAPID
# (ex.: py-vapid) e instale pywebpush. Sem isso, o botão de ativar
# notificações no Portal do Membro nem aparece.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:naoresponda@igreja.local

# SMS (opcional, "preparado, não integrado") — sem um provedor escolhido,
# o envio cai sempre no fallback de log/console (ver core/sms.py). Quando
# escolher um provedor (Twilio, Zenvia, Total Voice, AWS SNS etc.), esses
# 3 valores ficam disponíveis em settings.SMS_PROVIDER/SMS_API_KEY/SMS_API_SECRET.
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
